# ─────────────────────────────────────────────
# Required: OpenAI API Key (classification + bilingual summaries)
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─────────────────────────────────────────────
# Required: Gemini API Key (real-time web search via Google Search Grounding)
# Get it at: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────
GEMINI_API_KEY=AIza...

# ─────────────────────────────────────────────
# Optional: Supabase (if not set, uses JSON file storage)
# ─────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ─────────────────────────────────────────────
# Cron protection secret (set same value in Vercel env vars)
# ─────────────────────────────────────────────
CRON_SECRET=your-super-secret-cron-token

# ─────────────────────────────────────────────
# App URL (used for internal API calls from cron)
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
